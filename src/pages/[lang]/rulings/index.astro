---
import Base from '../../../layouts/Base.astro';
import Entry from '../../../components/Entry.astro';
import ListFilters from '../../../components/ListFilters.astro';
import data from '../../../../data/rulings.json';
import { byDateDesc } from '../../../lib';
import { t, LANGS, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const items: any[] = [...data].sort(byDateDesc('date'));
---
<Base title={t(lang, 'rul.title')} lang={lang}>
  <h1>{t(lang, 'rul.title')}</h1>
  <p class="lead">{t(lang, 'rul.lead')}</p>
  <ListFilters items={items} lang={lang} target="#list" mapCaption={`${t(lang, 'map.rulings')} · ${t(lang, 'map.all')}`} />
  <div id="list" class="list">{items.map(i => <Entry item={i} lang={lang} kind="rulings" />)}</div>
  <p class="src" style="margin-top:16px">{t(lang,'rul.disclaimer')} </p>
</Base>
