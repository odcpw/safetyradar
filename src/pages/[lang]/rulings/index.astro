---
import Base from '../../../layouts/Base.astro';
import ItemCard from '../../../components/ItemCard.astro';
import Filters from '../../../components/Filters.astro';
import data from '../../../../data/rulings.json';
import { byDateDesc, uniq } from '../../../lib';
import { t, tax, LANGS, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const items: any[] = [...data].sort(byDateDesc('date'));
---
<Base title={t(lang, 'rul.title')} lang={lang}>
  <h1>{t(lang, 'rul.title')}</h1>
  <p class="lead">{t(lang, 'rul.lead')}</p>
  <Filters lang={lang} target="#list" filters={[{ key: 'canton', label: t(lang,'filter.canton'), options: uniq(items.map(i=>i.canton)).map(c=>[c,c]) },{ key: 'outcome', label: t(lang,'f.severity'), options: uniq(items.map(i=>i.outcome).filter(Boolean)).map(h=>[h,tax(lang,'outcome',h)]) },{ key: 'industry', label: t(lang,'filter.industry'), options: uniq(items.map(i=>i.industry).filter(Boolean)).map(h=>[h,tax(lang,'industry',h)]) },{ key: 'lang', label: t(lang,'filter.lang'), options: uniq(items.map(i=>i.source.lang)).map(h=>[h,h.toUpperCase()]) }] as any} />
  <div id="list" class="grid">{items.map(i => <ItemCard item={i} lang={lang} kind="rulings" />)}</div>
  <p class="src" style="margin-top:16px">{t(lang,'rul.disclaimer')} {t(lang,'date.event')}</p>
</Base>
