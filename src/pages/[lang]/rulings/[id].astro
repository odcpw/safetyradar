---
import Base from '../../../layouts/Base.astro';
import RulingSlim from '../../../components/RulingSlim.astro';
import data from '../../../../data/rulings.json';
import { t, pick, LANGS, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return LANGS.flatMap(lang => data.map((item: any) => ({ params: { lang, id: item.id }, props: { item } }))); }
const lang = Astro.params.lang as Lang; const { item } = Astro.props as any;
const title = pick(lang, item.title)!;
---
<Base title={title} lang={lang} description={pick(lang, item.facts?.what) ?? undefined}>
  <p class="back"><a id="backlink" href={`/${lang}/rulings/`}>{t(lang, 'back')}</a></p>
  <article class={`perma sev-${item.outcome ?? 'none'}`}>
    <h1>{title}</h1>
    <RulingSlim item={item} lang={lang} />
  </article>
  <p class="src">{t(lang,'detail.disclaimer')}</p>
  <script is:inline>(function(){var a=document.getElementById('backlink');try{var r=new URL(document.referrer);if(r.origin===location.origin&&r.pathname===a.pathname)a.href=r.href;}catch(e){}})();</script>
</Base>
