---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang } from '../../i18n/ui';
import { IMPRINT } from '../../i18n/legal';
export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang; const c = IMPRINT[lang];
---
<Base title={c.title} lang={lang}><h1>{c.title}</h1><Fragment set:html={c.html} /></Base>
