---
import Base from '../../../layouts/Base.astro';
import { t, LANGS, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
---
<Base title={t(lang,'nav.postjob')} lang={lang}>
  <h1>{t(lang,'postjob.title')}</h1>
  <p class="lead">{t(lang,'postjob.lead')}</p>
  <div class="grid cols-3">{['postjob.b1','postjob.b2','postjob.b3'].map(k => <div class="card"><p>{t(lang,k)}</p></div>)}</div>
  <p class="notice" style="margin-top:16px">{t(lang,'postjob.contact')} <span class="todo">{t(lang,'todo.email')}</span>. {t(lang,'postjob.free')}</p>
</Base>
