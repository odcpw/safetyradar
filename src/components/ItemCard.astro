---
import { CANTONS, fmtDate } from '../lib';
import { t, tax, pick, type Lang } from '../i18n/ui';
const { item, lang, kind } = Astro.props as { item: any; lang: Lang; kind: 'accidents' | 'rulings' };
const href = `/${lang}/${kind}/${item.id}/`;
const lesson = pick(lang, item.lesson);
---
<article class={`card compact item sev-${item.outcome ?? 'none'}`} data-canton={item.canton} data-outcome={item.outcome ?? ''} data-industry={item.industry ?? ''} data-lang={item.source.lang}>
  <div class="v-only gutter"><time datetime={item.date}>{fmtDate(item.date, lang)}</time><span class="gc" title={CANTONS[item.canton]}>{item.canton}</span></div>
  <div class="body">
    <div class="meta">
      <span class="tag canton" title={CANTONS[item.canton]}>{item.canton}</span>
      <span class="tag">{fmtDate(item.date, lang)}</span>
      {item.industry && <span class="tag">{tax(lang, 'industry', item.industry)}</span>}
      {item.outcome && <span class={`tag out ${item.outcome}`}>{tax(lang, 'outcome', item.outcome)}</span>}
      {kind === 'rulings' && <span class="tag">{pick(lang, item.court)}</span>}
    </div>
    <h3><a href={href}>{pick(lang, item.title)}</a></h3>
    <div class="v-only meta2">
      <span class="m-canton tag canton" title={CANTONS[item.canton]}>{item.canton}</span>
      {item.outcome && <span class="m-sev">{tax(lang, 'outcome', item.outcome)}</span>}
      <span class="m-date">{fmtDate(item.date, lang)}</span>
      {item.industry && <span>{tax(lang, 'industry', item.industry)}</span>}
      {kind === 'rulings' && item.court && <span>{pick(lang, item.court)}</span>}
      {item.place && <span>{item.place}</span>}
      <span class="m-src">{item.source.name} ({item.source.lang.toUpperCase()})</span>
    </div>
    {lesson && <p class="v-only teaser">{lesson}</p>}
    <div class="src">{item.place && <>{item.place} · </>}{t(lang, 'source')}: {item.source.name} ({item.source.lang.toUpperCase()}) · <a href={href}>{t(lang, 'details')}</a></div>
  </div>
</article>
