---
import { pick, type Lang } from '../i18n/ui';
type Lesson = Record<Lang, string> & { refs: { id: string; label: string; url: string }[] };
const { lesson, lang } = Astro.props as { lesson: Lesson | null; lang: Lang };
const text = pick(lang, lesson);
---
{lesson && text && <p class="lesson"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.9-4.9 1.4 1.4-6.3 6.3Z"/></svg><span>{text}<span class="lesson-refs">{lesson.refs.map((ref, i) => <>{i > 0 && ' · '}<a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label}</a></>)}</span></span></p>}
<style>
  .lesson-refs { display: block; margin-top: .25rem; font-size: .85em; }
</style>
