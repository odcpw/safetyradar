---
import Lesson from './Lesson.astro';
import { allegationText } from '../../scripts/lib/legal-display.mjs';
import { fmtDate, sanctionText } from '../lib';
import { linkifyArticles } from '../lib/fedlex';
import { t, tax, pick, type Lang } from '../i18n/ui';
const { item, lang, permalink = false } = Astro.props as { item: any; lang: Lang; permalink?: boolean };
const tt = (k: string) => t(lang, k); const pk = (v: any) => pick(lang, v);
const meta = [item.accidentDate ? `${tt('r.accidentDate')} ${fmtDate(item.accidentDate, lang)}` : null, `${tt('r.judgmentDate')} ${fmtDate(item.date, lang)}`, item.published ? `${t(lang, 'r.published')} ${fmtDate(item.published, lang)}` : null, pk(item.court), item.place ? `${item.place} (${item.canton})` : item.canton, tax(lang, 'outcome', item.outcome), item.caseStatus && item.caseStatus !== 'unknown' ? tt('case.' + item.caseStatus) : null].filter(Boolean);
const why = pk(item.why) ?? (item.defendants?.length === 1 ? null : null);
const line = (d: any) => {
  const head = d.allegations?.length ? d.allegations.map((a: any) => allegationText(a, lang, (status: string) => tt('legal.' + status))).join('; ') : tt('legal.' + d.verdict);
  const sanc = d.verdict === 'convicted' ? (sanctionText(d.sanction, lang, tt, pk) || '') : '';
  const history = (d.sanctionHistory || []).map((h: any) => `${tt('history.' + h.stage)}${h.date ? ' (' + fmtDate(h.date, lang) + ')' : ''}: ${sanctionText(h.sanction, lang, tt, pk)}`).join('; ');
  const reason = pk(d.short) ?? pk(d.reasoning);
  const text = `${head}${sanc ? ' — ' + sanc : ''}.${history ? ' ' + history + '.' : ''}`;
  return { role: pk(d.role), parts: linkifyArticles(text, lang), reason };
};
---
<div class="slim">
  <p class="mline">{meta.join(' · ')}{item.caseNumber && <> · {item.caseNumber}</>}</p>
  {pk(item.facts?.what) && <p><span class="lbl">{tt('r.what')}</span> {pk(item.facts.what)}</p>}
  {pk(item.facts?.injuries) && <p><span class="lbl">{tt('r.injuries')}</span> {pk(item.facts.injuries)}</p>}
  {pk(item.appeal) && <p><span class="lbl">{tt('r.decided')}</span> {pk(item.appeal)}</p>}
  {why && <p><span class="lbl">{tt('r.why')}</span> {why}</p>}
  {item.defendants?.length > 0 && <ul class="people">{item.defendants.map((d: any) => { const l = line(d); return <li class={`v-${d.verdict}`}><b>{l.role}:</b> {l.parts.map(p => p.type === 'link' ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.value}</a> : p.value)} {l.reason && <span class="why">{l.reason}</span>}</li>; })}</ul>}
  <Lesson lesson={item.lesson} lang={lang} />
  <p class="srcline">{tt('source')}: <a href={item.source.url} target="_blank" rel="noopener">{item.source.name}</a> ({item.source.lang.toUpperCase()}){item.extraSources?.map((s: any) => <> · <a href={s.url} target="_blank" rel="noopener">{s.name}</a> ({s.lang.toUpperCase()})</>)}
  </p>
</div>
