# Safety Radar – environment variables (copy to .env, never commit .env). No values here on purpose.
# --- Pipeline (npm run update) ---
OPENAI_API_KEY=            # OpenAI key for classify/draft steps. Unset = LLM steps skipped with a warning.
LLM_MODEL=                 # Model for classify steps (default gpt-6-luna)
LLM_DRAFT_MODEL=           # Model for ruling drafts (default gpt-6-luna)
LLM_EFFORT_EXTRACT=        # Reasoning effort for news/ruling field extraction (default low)
LLM_EFFORT_JOBS=           # Reasoning effort for job classification (default low)
LLM_EFFORT_DRAFT=          # Reasoning effort for ruling drafts (default medium)
LLM_FIELDS_VIA=            # responses (default) | decisions – which API extracts enumerable fields
LLM_MAX_CALLS=             # Hard cap API calls per script run (default 300)
LLM_MAX_TOKENS=            # Hard cap tokens per script run (default 1000000)
LLM_MAX_USD=               # Hard cap estimated USD per script run (default 0.50)
LLM_USD_CHF=               # USD->CHF rate for cost log in data/llm-usage.jsonl
LLM_BATCH=                 # Titles per Decisions API batch (default 20)
LLM_STAGE2_MIN=            # Min Decisions probability to send an item to field extraction (default 0.1)
LLM_FORCE=                 # 1 = re-label items that already have an llm label
LLM_REDO_STAGE2=           # 1 = reuse cached first sort, redo field extraction (comparison runs)
DRAFT_MAX=                 # Max ruling drafts per run (default 5)
DRAFT_ONLY=                # Comma-separated ids: draft only these rulings
DRAFT_INCLUDE_PUBLISHED=   # 1 = also draft rulings already in rulings.json
# --- Build (npm run build) ---
SITE=                      # Canonical origin (default https://safetyradar.ch)
BASE=                      # Base path (default /)
NOINDEX=                   # 1 = noindex meta + disallow-all robots.txt (keep 1 until go-live)
# --- E-mail intake (scripts/email-intake.mjs) ---
AGENTMAIL_API_KEY=         # AgentMail API key with read access to the intake inbox. Unset = intake skipped with a warning.
AGENTMAIL_INBOX=           # Intake inbox (default odcpw@mail.grokbot.com; +tags police-*/jobs-* are derived from it)
AGENTMAIL_BASE_URL=        # API origin (default https://api.agentmail.to; EU: https://api.agentmail.eu)
INTAKE_MAX_MESSAGES=       # Max messages pulled per run (default 200)
INTAKE_KEEP_DAYS=          # Delete data/inbox files older than this (default 21)
# --- Stage 2 reviewer (reviewer/, Node >= 22.19) ---
REVIEW_MODEL=              # OpenAI model (default gpt-6.1-sol; must have a verified price in reviewer/src/cost.ts)
REVIEW_THINKING=           # Reasoning level (default medium)
REVIEW_MAX_USD=            # Hard cap per reviewer run (default 1.00)
REVIEW_DAILY_MAX_USD=      # Hard cap for all reviewer runs of one day incl. dry runs/retries (default 3.00)
REVIEW_MAX_TOOL_CALLS=     # Tool-call limit per run (default 80)
REVIEW_BASE=               # Base the review worktree starts from (default: main if GIT_PUSH=0, origin/main if GIT_PUSH=1)
REVIEW_STATE_DIR=          # SQLite sessions, usage, diffs, worktrees (default reviewer/state, gitignored)
REVIEW_ARGS=               # Extra args for the daily run, e.g. --dry-run
# --- Git mode ---
GIT_PUSH=                  # 0 (default, VPS local mode): commit data to the local main, never push; code arrives by git pull --rebase over https.
                           # 1 (GitHub Pages mode): the reviewer pushes its validated commit to origin main (needs GH_TOKEN or a deploy key).
GH_TOKEN=                  # GIT_PUSH=1 only. Fine-grained PAT, repo odcpw/safetyradar only: Contents read/write (nothing else). Used by git via gh auth setup-git; or use an SSH deploy key with write access and leave this empty.
GIT_AUTHOR_NAME=           # Commit identity (default odcpw)
GIT_AUTHOR_EMAIL=          # (default odcpw@users.noreply.github.com)
# --- Daily run (deploy/run-daily.sh) ---
PUBLISH_DIR=               # Served dir, e.g. /srv/safetyradar/www. Missing or a symlink: atomic release swap (<dir>.releases/<stamp>, keeps 5);
                           # an existing plain directory: rsync --delete-after. Empty = no publish (GitHub Pages mode).
BACKUP_DIR=                # deploy/backup.sh target (default ~/backups); BACKUP_KEEP_DAYS= (default 14)
SKIP_PULL=                 # 1 = don't git pull main first (testing)
SKIP_INSTALL=              # 1 = skip npm ci
SKIP_STAGE1=               # 1 = skip npm run update
SKIP_REVIEW=               # 1 = skip the reviewer
