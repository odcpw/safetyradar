[Unit]
Description=Safety Radar daily run (stage 1 fetch/classify, e-mail intake, LLM reviewer -> review PR, publish build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=safetyradar
Group=safetyradar
WorkingDirectory=/opt/safetyradar
# Secrets: /opt/safetyradar/.env (chmod 600, owner safetyradar). Never commit it.
EnvironmentFile=/opt/safetyradar/.env
Environment=NOINDEX=1 SITE=https://safetyradar.ch BASE=/ PUBLISH_DIR=/var/www/safetyradar SAFETYRADAR_ENV_LOADED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/safetyradar/deploy/run-daily.sh
TimeoutStartSec=90min
# Hardening: the job only needs its checkout, the web root and the network.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/safetyradar /var/www/safetyradar
