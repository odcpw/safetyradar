[Unit]
Description=Safety Radar daily run (code pull, stage 1, e-mail intake, LLM reviewer -> local commit, atomic publish to /srv/safetyradar/www)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=safetyradar
Group=safetyradar
WorkingDirectory=/srv/safetyradar/app
# Secrets + mode: /srv/safetyradar/.env (600, safetyradar; app/.env symlinks to it): GIT_PUSH=0, PUBLISH_DIR=/srv/safetyradar/www,
# NOINDEX=1, SITE/BASE. Values are taken from .env only (no Environment= overrides), so .env is the single switch.
EnvironmentFile=/srv/safetyradar/.env
Environment=SAFETYRADAR_ENV_LOADED=1 HOME=/srv/safetyradar
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/safetyradar/app/deploy/run-daily.sh
TimeoutStartSec=90min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/safetyradar
