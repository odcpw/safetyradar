# Safety Radar on the VPS (append to /etc/caddy/Caddyfile, then `caddy validate` + `systemctl reload caddy`).
# Caddy obtains and renews Let's Encrypt certificates automatically once DNS points here.
# /srv/safetyradar/www is a symlink to the current release (deploy/run-daily.sh switches it atomically).
www.safetyradar.ch {
	redir https://safetyradar.ch{uri} permanent
}

safetyradar.ch {
	root * /srv/safetyradar/www
	encode zstd gzip
	# remove at go-live together with NOINDEX=1
	header X-Robots-Tag "noindex, nofollow"
	header Cache-Control "public, max-age=300, must-revalidate"
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# The Astro build has no 404.html yet, so Caddy returns its plain 404. Once src/pages/404.astro exists, add:
	#   handle_errors 404 { rewrite * /404.html
	#                       file_server }
	file_server
}
