{
  "name": "safetyradar",
  "version": "1.0.0",
  "description": "Safety Radar – Swiss workplace accidents, court rulings and safety jobs (static Astro site + Node fetch pipeline)",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/rebase.mjs",
    "preview": "astro preview",
    "fetch": "node scripts/fetch-sources.mjs",
    "update": "node scripts/update.mjs",
    "queue": "node scripts/queue-report.mjs",
    "fetch:jobs": "node scripts/fetch-jobs.mjs",
    "classify": "node scripts/classify.mjs",
    "classify:jobs": "node scripts/classify-jobs.mjs",
    "draft:rulings": "node scripts/draft-rulings.mjs",
    "validate": "node scripts/validate-data.mjs",
    "intake": "node scripts/email-intake.mjs",
    "review": "npm --prefix reviewer run review --",
    "daily": "deploy/run-daily.sh",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "astro": "^5.18.2"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "private": true
}
